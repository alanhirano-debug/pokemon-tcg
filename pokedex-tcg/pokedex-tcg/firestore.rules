rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só enxerga e escreve na própria coleção.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
